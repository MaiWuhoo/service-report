rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{reportId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /company/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /customers/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
